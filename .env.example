# Backblaze B2 (required) — S3-compatible API
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# Region selects the S3 endpoint (https://s3.<region>.backblazeb2.com).
# Find it in the B2 bucket "Endpoint" value, e.g. us-west-004, us-east-005.
B2_REGION=us-west-004

# Optional: public base URL for a PUBLIC bucket. Only needed to build direct
# (non-presigned) object URLs; the app works without it. Example shape:
# B2_PUBLIC_URL_BASE=https://f004.backblazeb2.com/file/your-bucket-name

# The application key needs listBuckets, listFiles, readFiles, writeFiles and
# deleteFiles on the bucket above (writes: raw scans + job artifacts; deletes:
# scoped to each job's own jobs/<id>/ prefix).

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
